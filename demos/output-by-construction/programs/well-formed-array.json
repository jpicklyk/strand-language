    "annNilMc": {
      "type": "MatchCase",
      "pattern": "annNilPat",
      "body": "trueLit"
    },
    "annMatch": {
      "type": "Match",
      "scrutinee": "annXsRef",
      "cases": [
        "annConsMc",
        "annNilMc"
      ]
    },
    "annLambda": {
      "type": "Lambda",
      "parameters": [
        "annRecurse",
        "annXs"
      ],
      "body": "annMatch"
    },
    "allNonNegFn": {
      "type": "Fixpoint",
      "recursionType": "allNonNegT",
      "body": "annLambda"
    },
    "nonNegInvariant": {
      "type": "Invariant",
      "invariantName": "all_elements_non_negative",
      "targetSchema": "nonNegArraySchema",
      "body": "allNonNegFn"
