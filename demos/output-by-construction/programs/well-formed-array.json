    "cons3Head": {
      "type": "ProductFieldValue",
      "fieldName": "head",
      "value": "num3"
    },
    "cons3Tail": {
      "type": "ProductFieldValue",
      "fieldName": "tail",
      "value": "nilVal"
    },
    "cons3Prod": {
      "type": "ProductValue",
      "ofType": "projCons",
      "fields": [
        "cons3Head",
        "cons3Tail"
      ]
    },
    "cons3": {
      "type": "SumValue",
      "ofType": "projList",
      "caseName": "Cons",
      "payload": "cons3Prod"
    },
    "cons2Head": {
      "type": "ProductFieldValue",
      "fieldName": "head",
      "value": "num2"
    },
    "cons2Tail": {
      "type": "ProductFieldValue",
      "fieldName": "tail",
      "value": "cons3"
    },
    "cons2Prod": {
      "type": "ProductValue",
      "ofType": "projCons",
      "fields": [
        "cons2Head",
        "cons2Tail"
      ]
    },
    "cons2": {
      "type": "SumValue",
      "ofType": "projList",
      "caseName": "Cons",
      "payload": "cons2Prod"
    },
    "cons1Head": {
      "type": "ProductFieldValue",
      "fieldName": "head",
      "value": "num1"
    },
    "cons1Tail": {
      "type": "ProductFieldValue",
      "fieldName": "tail",
      "value": "cons2"
    },
    "cons1Prod": {
      "type": "ProductValue",
      "ofType": "projCons",
      "fields": [
        "cons1Head",
        "cons1Tail"
      ]
    },
    "arrayList": {
      "type": "SumValue",
      "ofType": "projList",
      "caseName": "Cons",
      "payload": "cons1Prod"
    },
    "geFnT": {
      "type": "FunctionType",
      "parameters": [
        "intT",
        "intT"
      ],
      "result": "boolT"
    },
    "geFn": {
      "type": "ForeignNode",
      "target": "strand-builtin:Int.Ge",
      "foreignType": "geFnT"
    },
    "boolAndT": {
      "type": "FunctionType",
      "parameters": [
        "boolT",
        "boolT"
      ],
      "result": "boolT"
    },
    "boolAnd": {
      "type": "ForeignNode",
      "target": "strand-builtin:Bool.And",
      "foreignType": "boolAndT"
    },
    "allNonNegT": {
      "type": "FunctionType",
      "parameters": [
        "projList"
      ],
      "result": "boolT"
    },
    "annRecurse": {
      "type": "ParameterDecl",
      "name": "self",
      "paramType": "allNonNegT"
    },
    "annXs": {
      "type": "ParameterDecl",
      "name": "xs",
      "paramType": "projList"
    },
    "annRecRef": {
      "type": "VarRef",
      "binder": "annRecurse"
    },
    "annXsRef": {
      "type": "VarRef",
      "binder": "annXs"
    },
    "annConsVar": {
      "type": "Pattern",
      "kind": "variable",
      "patternType": "projCons",
      "name": "c"
    },
    "annConsPat": {
      "type": "Pattern",
      "kind": "constructor",
      "patternType": "projList",
      "caseName": "Cons",
      "payloadPattern": "annConsVar"
    },
    "annCRef": {
      "type": "VarRef",
      "binder": "annConsVar"
    },
    "annHeadJv": {
      "type": "ProductFieldGet",
      "target": "annCRef",
      "fieldName": "head"
    },
    "annTailLst": {
      "type": "ProductFieldGet",
      "target": "annCRef",
      "fieldName": "tail"
    },
    "annNumVar": {
      "type": "Pattern",
      "kind": "variable",
      "patternType": "intT",
      "name": "n"
    },
    "annNumPat": {
      "type": "Pattern",
      "kind": "constructor",
      "patternType": "jsonValueT",
      "caseName": "JsonNumber",
      "payloadPattern": "annNumVar"
    },
    "annNRef": {
      "type": "VarRef",
      "binder": "annNumVar"
    },
    "zeroLit": {
      "type": "IntLit",
      "value": 0
    },
    "headIsNonNeg": {
      "type": "Application",
      "function": "geFn",
      "arguments": [
        "annNRef",
        "zeroLit"
      ]
    },
    "annNumMc": {
      "type": "MatchCase",
      "pattern": "annNumPat",
      "body": "headIsNonNeg"
    },
    "falseLit": {
      "type": "BoolLit",
      "value": false
    },
    "annHeadWild": {
      "type": "Pattern",
      "kind": "wildcard",
      "patternType": "jsonValueT"
    },
    "annHeadWildMc": {
      "type": "MatchCase",
      "pattern": "annHeadWild",
      "body": "falseLit"
    },
    "headOk": {
      "type": "Match",
      "scrutinee": "annHeadJv",
      "cases": [
        "annNumMc",
        "annHeadWildMc"
      ]
    },
    "annRecCall": {
      "type": "Application",
      "function": "annRecRef",
      "arguments": [
        "annTailLst"
      ]
    },
    "annConsBody": {
      "type": "Application",
      "function": "boolAnd",
      "arguments": [
        "headOk",
        "annRecCall"
      ]
    },
    "annConsMc": {
      "type": "MatchCase",
      "pattern": "annConsPat",
      "body": "annConsBody"
    },
    "annNilPat": {
      "type": "Pattern",
      "kind": "constructor",
      "patternType": "projList",
      "caseName": "Nil"
    },
    "trueLit": {
      "type": "BoolLit",
      "value": true
