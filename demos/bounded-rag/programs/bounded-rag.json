{
  "version": 1,
  "root": "pipeline",
  "nodes": {
    "strT":    { "type": "PrimitiveType", "kind": "String" },
    "intT":    { "type": "PrimitiveType", "kind": "Int" },
    "floatT":  { "type": "PrimitiveType", "kind": "Float" },
    "boolT":   { "type": "PrimitiveType", "kind": "Bool" },
    "bytesT":  { "type": "PrimitiveType", "kind": "Bytes" },

    "llmEmbedFx":   { "type": "EffectCategory", "categoryName": "LLM.Embed",
                      "parameters": ["strT", "strT"] },
    "vectorReadFx": { "type": "EffectCategory", "categoryName": "Vector.Read",
                      "parameters": ["strT", "strT"] },
    "llmGenFx":     { "type": "EffectCategory", "categoryName": "LLM.Generate",
                      "parameters": ["strT", "strT"] },

    "cosineCase":   { "type": "SumTypeCase", "name": "Cosine",     "caseType": null },
    "dotCase":      { "type": "SumTypeCase", "name": "DotProduct", "caseType": null },
    "euclidCase":   { "type": "SumTypeCase", "name": "Euclidean",  "caseType": null },
    "manhatCase":   { "type": "SumTypeCase", "name": "Manhattan",  "caseType": null },
    "metricSumT":   { "type": "SumType", "cases": ["cosineCase", "dotCase", "euclidCase", "manhatCase"] },

    "someMetricCase": { "type": "SumTypeCase", "name": "Some", "caseType": "metricSumT" },
    "noneMetricCase": { "type": "SumTypeCase", "name": "None", "caseType": null },
    "metricOptionT":  { "type": "SumType", "cases": ["someMetricCase", "noneMetricCase"] },

    "jsonNullCase":   { "type": "SumTypeCase", "name": "JsonNull",   "caseType": null },
    "jsonBoolCase":   { "type": "SumTypeCase", "name": "JsonBool",   "caseType": "boolT" },
    "jsonNumCase":    { "type": "SumTypeCase", "name": "JsonNumber", "caseType": "intT" },
    "jsonStrCase":    { "type": "SumTypeCase", "name": "JsonString", "caseType": "strT" },
    "jsonValueT":     { "type": "SumType",
                        "cases": ["jsonNullCase", "jsonBoolCase", "jsonNumCase", "jsonStrCase"] },

    "someFilterCase": { "type": "SumTypeCase", "name": "Some", "caseType": "jsonValueT" },
    "noneFilterCase": { "type": "SumTypeCase", "name": "None", "caseType": null },
    "filterOptionT":  { "type": "SumType", "cases": ["someFilterCase", "noneFilterCase"] },

    "someVecCase":  { "type": "SumTypeCase", "name": "Some", "caseType": "bytesT" },
    "noneVecCase":  { "type": "SumTypeCase", "name": "None", "caseType": null },
    "vectorOptionT":{ "type": "SumType", "cases": ["someVecCase", "noneVecCase"] },

    "embedModelFldT": { "type": "ProductTypeField", "name": "model", "fieldType": "strT" },
    "embedTextFldT":  { "type": "ProductTypeField", "name": "text",  "fieldType": "strT" },
    "embedRequestT":  { "type": "ProductType", "fields": ["embedModelFldT", "embedTextFldT"] },

    "embedFnT": { "type": "FunctionType", "parameters": ["embedRequestT"], "result": "bytesT",
                  "effects": ["llmEmbedFx"] },
    "embed":    { "type": "ForeignNode", "target": "strand-builtin:OpenAI.Embeddings.Create",
                  "foreignType": "embedFnT", "effects": ["llmEmbedFx"] },

    "indexNameFldT": { "type": "ProductTypeField", "name": "indexName",   "fieldType": "strT" },
    "envFldT":       { "type": "ProductTypeField", "name": "environment", "fieldType": "strT" },
    "metricFldT":    { "type": "ProductTypeField", "name": "metric",      "fieldType": "metricSumT" },
    "dimsFldT":      { "type": "ProductTypeField", "name": "dimensions",  "fieldType": "intT" },
    "configT":       { "type": "ProductType",
                       "fields": ["indexNameFldT", "envFldT", "metricFldT", "dimsFldT"] },

    "handleT":  { "type": "PrimitiveType", "kind": "Int" },
    "openFnT":  { "type": "FunctionType", "parameters": ["configT"], "result": "handleT",
                  "effects": ["vectorReadFx"] },
    "open":     { "type": "ForeignNode", "target": "strand-builtin:Pinecone.Index.Open",
                  "foreignType": "openFnT", "effects": ["vectorReadFx"] },

    "qVectorFldT":   { "type": "ProductTypeField", "name": "vector",          "fieldType": "bytesT" },
    "qKFldT":        { "type": "ProductTypeField", "name": "k",               "fieldType": "intT" },
    "qFilterFldT":   { "type": "ProductTypeField", "name": "filter",          "fieldType": "filterOptionT" },
    "qIncVecFldT":   { "type": "ProductTypeField", "name": "includeVector",   "fieldType": "boolT" },
    "qIncMetaFldT":  { "type": "ProductTypeField", "name": "includeMetadata", "fieldType": "boolT" },
    "qMetricFldT":   { "type": "ProductTypeField", "name": "metric",          "fieldType": "metricOptionT" },
    "queryReqT":     { "type": "ProductType",
                       "fields": ["qVectorFldT", "qKFldT", "qFilterFldT", "qIncVecFldT",
                                  "qIncMetaFldT", "qMetricFldT"] },

    "hitIdFldT":     { "type": "ProductTypeField", "name": "id",       "fieldType": "strT" },
    "hitScoreFldT":  { "type": "ProductTypeField", "name": "score",    "fieldType": "floatT" },
    "hitMetaFldT":   { "type": "ProductTypeField", "name": "metadata", "fieldType": "jsonValueT" },
    "hitVecFldT":    { "type": "ProductTypeField", "name": "vector",   "fieldType": "vectorOptionT" },
    "queryHitT":     { "type": "ProductType",
                       "fields": ["hitIdFldT", "hitScoreFldT", "hitMetaFldT", "hitVecFldT"] },

    "hitsHeadFldT":  { "type": "ProductTypeField", "name": "head", "fieldType": "queryHitT" },
    "hitsTailFldT":  { "type": "ProductTypeField", "name": "tail", "fieldType": "hitsRecSelf" },
    "hitsConsBody":  { "type": "ProductType", "fields": ["hitsHeadFldT", "hitsTailFldT"] },
    "hitsConsCase":  { "type": "SumTypeCase", "name": "Cons", "caseType": "hitsConsBody" },
    "hitsNilCase":   { "type": "SumTypeCase", "name": "Nil",  "caseType": null },
    "hitsBody":      { "type": "SumType", "cases": ["hitsConsCase", "hitsNilCase"] },
    "hitsRecSelf":   { "type": "RecursiveSelf" },
    "hitsT":         { "type": "RecursiveType", "body": "hitsBody" },

    "queryFnT": { "type": "FunctionType", "parameters": ["handleT", "queryReqT"], "result": "hitsT",
                  "effects": ["vectorReadFx"] },
    "query":    { "type": "ForeignNode", "target": "strand-builtin:Pinecone.Index.Query",
                  "foreignType": "queryFnT", "effects": ["vectorReadFx"] },

    "msgHeadFldInner": { "type": "ProductTypeField", "name": "head", "fieldType": "bytesT" },
    "msgTailFldInner": { "type": "ProductTypeField", "name": "tail", "fieldType": "msgRecSelf" },
    "msgConsInner":    { "type": "ProductType", "fields": ["msgHeadFldInner", "msgTailFldInner"] },
    "msgConsCase":     { "type": "SumTypeCase", "name": "Cons", "caseType": "msgConsInner" },
    "msgNilCase":      { "type": "SumTypeCase", "name": "Nil",  "caseType": null },
    "msgListBody":     { "type": "SumType", "cases": ["msgConsCase", "msgNilCase"] },
    "msgRecSelf":      { "type": "RecursiveSelf" },
    "msgListT":        { "type": "RecursiveType", "body": "msgListBody" },

    "genModelFldT":    { "type": "ProductTypeField", "name": "model",    "fieldType": "strT" },
    "genMessagesFldT": { "type": "ProductTypeField", "name": "messages", "fieldType": "msgListT" },
    "genToolsFldT":    { "type": "ProductTypeField", "name": "tools",    "fieldType": "msgListT" },
    "generateRequestT": { "type": "ProductType",
                          "fields": ["genModelFldT", "genMessagesFldT", "genToolsFldT"] },

    "genContentFldT":  { "type": "ProductTypeField", "name": "content",       "fieldType": "bytesT" },
    "genStopFldT":     { "type": "ProductTypeField", "name": "stopReason",    "fieldType": "bytesT" },
    "genUsageFldT":    { "type": "ProductTypeField", "name": "usage",         "fieldType": "bytesT" },
    "genFinalFldT":    { "type": "ProductTypeField", "name": "finalMessages", "fieldType": "bytesT" },
    "generateResultT": { "type": "ProductType",
                         "fields": ["genContentFldT", "genStopFldT", "genUsageFldT", "genFinalFldT"] },

    "generateFnT": { "type": "FunctionType", "parameters": ["generateRequestT"],
                     "result": "generateResultT", "effects": ["llmGenFx"] },
    "generate":    { "type": "ForeignNode", "target": "strand-builtin:Anthropic.Messages.Create",
                     "foreignType": "generateFnT", "effects": ["llmGenFx"] },

    "answerRetrievedFldT": { "type": "ProductTypeField", "name": "retrieved", "fieldType": "hitsT" },
    "answerGeneratedFldT": { "type": "ProductTypeField", "name": "answer",    "fieldType": "generateResultT" },
    "answerT": { "type": "ProductType", "fields": ["answerRetrievedFldT", "answerGeneratedFldT"] },

    "providerEmbedLit": { "type": "StringLit", "value": "openai" },
    "embedModelLit":    { "type": "StringLit", "value": "text-embedding-3-small" },
    "embedDecl":        { "type": "EffectDecl", "effectType": "llmEmbedFx",
                          "parameters": ["providerEmbedLit", "embedModelLit"] },

    "providerVecLit":   { "type": "StringLit", "value": "pinecone" },
    "storeLit":         { "type": "StringLit", "value": "corp-kb" },
    "readDecl":         { "type": "EffectDecl", "effectType": "vectorReadFx",
                          "parameters": ["providerVecLit", "storeLit"] },

    "providerGenLit":   { "type": "StringLit", "value": "anthropic" },
    "genModelLit":      { "type": "StringLit", "value": "claude-opus-4-7" },
    "genDecl":          { "type": "EffectDecl", "effectType": "llmGenFx",
                          "parameters": ["providerGenLit", "genModelLit"] },

    "embedModelFV": { "type": "ProductFieldValue", "fieldName": "model", "value": "embedModelLit" },
    "embedTextLit": { "type": "StringLit", "value": "What is the company travel reimbursement policy?" },
    "embedTextFV":  { "type": "ProductFieldValue", "fieldName": "text", "value": "embedTextLit" },
    "embedRequest": { "type": "ProductValue", "ofType": "embedRequestT",
                      "fields": ["embedModelFV", "embedTextFV"] },
    "embedCall":    { "type": "Application", "function": "embed", "arguments": ["embedRequest"],
                      "effectInstances": ["embedDecl"] },

    "indexNameFV": { "type": "ProductFieldValue", "fieldName": "indexName",   "value": "storeLit" },
    "envLit":      { "type": "StringLit", "value": "us-east-1-aws" },
    "envFV":       { "type": "ProductFieldValue", "fieldName": "environment", "value": "envLit" },
    "cosineV":     { "type": "SumValue", "ofType": "metricSumT", "caseName": "Cosine", "payload": null },
    "metricFV":    { "type": "ProductFieldValue", "fieldName": "metric",      "value": "cosineV" },
    "dimsLit":     { "type": "IntLit", "value": 3 },
    "dimsFV":      { "type": "ProductFieldValue", "fieldName": "dimensions",  "value": "dimsLit" },
    "configValue": { "type": "ProductValue", "ofType": "configT",
                     "fields": ["indexNameFV", "envFV", "metricFV", "dimsFV"] },
    "openCall":    { "type": "Application", "function": "open", "arguments": ["configValue"],
                     "effectInstances": ["readDecl"] },

    "qVectorRef":  { "type": "VarRef", "binder": "pipeline" },
    "qVectorFV":   { "type": "ProductFieldValue", "fieldName": "vector",          "value": "qVectorRef" },
    "qKLit":       { "type": "IntLit", "value": 3 },
    "qKFV":        { "type": "ProductFieldValue", "fieldName": "k",               "value": "qKLit" },
    "noneFilterV": { "type": "SumValue", "ofType": "filterOptionT", "caseName": "None", "payload": null },
    "qFilterFV":   { "type": "ProductFieldValue", "fieldName": "filter",          "value": "noneFilterV" },
    "falseLit":    { "type": "BoolLit", "value": false },
    "qIncVecFV":   { "type": "ProductFieldValue", "fieldName": "includeVector",   "value": "falseLit" },
    "trueLit":     { "type": "BoolLit", "value": true },
    "qIncMetaFV":  { "type": "ProductFieldValue", "fieldName": "includeMetadata", "value": "trueLit" },
    "noneMetricV": { "type": "SumValue", "ofType": "metricOptionT", "caseName": "None", "payload": null },
    "qMetricFV":   { "type": "ProductFieldValue", "fieldName": "metric",          "value": "noneMetricV" },
    "queryRequest":{ "type": "ProductValue", "ofType": "queryReqT",
                     "fields": ["qVectorFV", "qKFV", "qFilterFV", "qIncVecFV", "qIncMetaFV", "qMetricFV"] },
    "queryCall":   { "type": "Application", "function": "query",
                     "arguments": ["handleRef", "queryRequest"],
                     "effectInstances": ["readDecl"] },

    "genModelFV":   { "type": "ProductFieldValue", "fieldName": "model",    "value": "genModelLit" },
    "messagesNil":  { "type": "SumValue", "ofType": "msgListT", "caseName": "Nil", "payload": null },
    "genMessagesFV":{ "type": "ProductFieldValue", "fieldName": "messages", "value": "messagesNil" },
    "toolsNil":     { "type": "SumValue", "ofType": "msgListT", "caseName": "Nil", "payload": null },
    "genToolsFV":   { "type": "ProductFieldValue", "fieldName": "tools",    "value": "toolsNil" },
    "generateRequest": { "type": "ProductValue", "ofType": "generateRequestT",
                         "fields": ["genModelFV", "genMessagesFV", "genToolsFV"] },
    "generateCall": { "type": "Application", "function": "generate", "arguments": ["generateRequest"],
                      "effectInstances": ["genDecl"] },

    "hitsRef":     { "type": "VarRef", "binder": "letHits" },
    "retrievedFV": { "type": "ProductFieldValue", "fieldName": "retrieved", "value": "hitsRef" },
    "answerFV":    { "type": "ProductFieldValue", "fieldName": "answer",    "value": "generateCall" },
    "answerValue": { "type": "ProductValue", "ofType": "answerT",
                     "fields": ["retrievedFV", "answerFV"] },

    "letHits":     { "type": "Let", "name": "hits", "value": "queryCall", "body": "answerValue" },

    "handleRef":   { "type": "VarRef", "binder": "letHandle" },
    "letHandle":   { "type": "Let", "name": "handle", "value": "openCall", "body": "letHits" },

    "pipeline":    { "type": "Let", "name": "queryVector", "value": "embedCall", "body": "letHandle" }
  }
}
