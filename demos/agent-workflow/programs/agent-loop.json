{
  "version": 1,
  "root": "callApp",
  "nodes": {
    "strT":   { "type": "PrimitiveType", "kind": "String" },
    "bytesT": { "type": "PrimitiveType", "kind": "Bytes" },

    "llmGenFx": { "type": "EffectCategory", "categoryName": "LLM.Generate",
                  "parameters": ["strT", "strT"] },

    "headFieldInner": { "type": "ProductTypeField", "name": "head", "fieldType": "bytesT" },
    "tailFieldInner": { "type": "ProductTypeField", "name": "tail", "fieldType": "recSelf" },
    "consInner":      { "type": "ProductType", "fields": ["headFieldInner", "tailFieldInner"] },
    "consCase":       { "type": "SumTypeCase", "name": "Cons", "caseType": "consInner" },
    "nilCase":        { "type": "SumTypeCase", "name": "Nil",  "caseType": null },
    "listBody":       { "type": "SumType", "cases": ["consCase", "nilCase"] },
    "recSelf":        { "type": "RecursiveSelf" },
    "listT":          { "type": "RecursiveType", "body": "listBody" },

    "headFieldOuter": { "type": "ProductTypeField", "name": "head", "fieldType": "bytesT" },
    "tailFieldOuter": { "type": "ProductTypeField", "name": "tail", "fieldType": "listT" },
    "consOuter":      { "type": "ProductType", "fields": ["headFieldOuter", "tailFieldOuter"] },

    "modelFieldT":    { "type": "ProductTypeField", "name": "model",    "fieldType": "strT" },
    "messagesFieldT": { "type": "ProductTypeField", "name": "messages", "fieldType": "listT" },
    "toolsFieldT":    { "type": "ProductTypeField", "name": "tools",    "fieldType": "listT" },
    "generateRequestT": { "type": "ProductType",
                          "fields": ["modelFieldT", "messagesFieldT", "toolsFieldT"] },

    "contentFieldT":    { "type": "ProductTypeField", "name": "content",       "fieldType": "bytesT" },
    "stopReasonFldT":   { "type": "ProductTypeField", "name": "stopReason",    "fieldType": "bytesT" },
    "usageFieldT":      { "type": "ProductTypeField", "name": "usage",         "fieldType": "bytesT" },
    "finalMessagesFlT": { "type": "ProductTypeField", "name": "finalMessages", "fieldType": "bytesT" },
    "generateResultT":  { "type": "ProductType",
                          "fields": ["contentFieldT", "stopReasonFldT", "usageFieldT", "finalMessagesFlT"] },

    "anthropicGenT": { "type": "FunctionType", "parameters": ["generateRequestT"],
                       "result": "generateResultT", "effects": ["llmGenFx"] },
    "anthropicGen":  { "type": "ForeignNode", "target": "strand-builtin:Anthropic.Messages.Create",
                       "foreignType": "anthropicGenT", "effects": ["llmGenFx"] },

    "cityParamFldT": { "type": "ProductTypeField", "name": "city", "fieldType": "strT" },
    "lookupParamsT": { "type": "ProductType", "fields": ["cityParamFldT"] },
    "lookupSchema":  { "type": "Schema", "schemaName": "LookupParams",
                       "valueType": "lookupParamsT", "invariants": [] },

    "lookupImplParam": { "type": "ParameterDecl", "name": "params", "paramType": "lookupParamsT" },
    "lookupResultLit": { "type": "StringLit", "value": "sunny, 72F" },
    "lookupImpl":      { "type": "Lambda", "parameters": ["lookupImplParam"], "body": "lookupResultLit" },

    "lookupTool": { "type": "ToolDef", "name": "get_weather",
                    "description": "Look up the current weather for a given city.",
                    "parameterSchema": "lookupSchema",
                    "implementation": "lookupImpl" },

    "messagesNil": { "type": "SumValue", "ofType": "listT", "caseName": "Nil", "payload": null },

    "toolsNil":    { "type": "SumValue", "ofType": "listT", "caseName": "Nil", "payload": null },
    "toolHeadFV":  { "type": "ProductFieldValue", "fieldName": "head", "value": "lookupTool" },
    "toolTailFV":  { "type": "ProductFieldValue", "fieldName": "tail", "value": "toolsNil" },
    "toolCell":    { "type": "ProductValue", "ofType": "consOuter", "fields": ["toolHeadFV", "toolTailFV"] },
    "toolsConsV":  { "type": "SumValue", "ofType": "listT", "caseName": "Cons", "payload": "toolCell" },

    "modelLit":   { "type": "StringLit", "value": "claude-opus-4-7" },
    "modelFV":    { "type": "ProductFieldValue", "fieldName": "model",    "value": "modelLit" },
    "messagesFV": { "type": "ProductFieldValue", "fieldName": "messages", "value": "messagesNil" },
    "toolsFV":    { "type": "ProductFieldValue", "fieldName": "tools",    "value": "toolsConsV" },
    "requestValue": { "type": "ProductValue", "ofType": "generateRequestT",
                      "fields": ["modelFV", "messagesFV", "toolsFV"] },

    "providerLit": { "type": "StringLit", "value": "anthropic" },
    "callModelLit": { "type": "StringLit", "value": "claude-opus-4-7" },
    "callDecl":    { "type": "EffectDecl", "effectType": "llmGenFx",
                     "parameters": ["providerLit", "callModelLit"] },

    "callApp": { "type": "Application", "function": "anthropicGen",
                 "arguments": ["requestValue"], "effectInstances": ["callDecl"] }
  }
}
