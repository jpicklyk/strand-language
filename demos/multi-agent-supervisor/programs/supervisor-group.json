{
  "version": 1,
  "root": "rootLet",
  "nodes": {
    "intT":              { "type": "PrimitiveType", "kind": "Int" },
    "strT":              { "type": "PrimitiveType", "kind": "String" },

    "someIntCase":       { "type": "SumTypeCase", "name": "Some", "caseType": "intT" },
    "noneIntCase":       { "type": "SumTypeCase", "name": "None", "caseType": null },
    "optionIntT":        { "type": "SumType", "cases": ["someIntCase", "noneIntCase"] },

    "addT":              { "type": "FunctionType", "parameters": ["intT", "intT"], "result": "intT" },
    "addFn":             { "type": "ForeignNode", "target": "strand-builtin:Int.Add", "foreignType": "addT" },

    "writeFx":           { "type": "EffectCategory", "categoryName": "Filesystem.Write", "parameters": ["strT"] },
    "writeT":            { "type": "FunctionType", "parameters": ["strT"], "result": "intT", "effects": ["writeFx"] },
    "writeFn":           { "type": "ForeignNode", "target": "strand-builtin:Test.EffectfulNoOp", "foreignType": "writeT", "effects": ["writeFx"] },

    "workerOutput0F":    { "type": "ProductTypeField", "name": "output_0", "fieldType": "optionIntT" },
    "workerOutputBatchT":{ "type": "ProductType", "fields": ["workerOutput0F"] },
    "workerStateF":      { "type": "ProductTypeField", "name": "state", "fieldType": "intT" },
    "workerOutputsF":    { "type": "ProductTypeField", "name": "outputs", "fieldType": "workerOutputBatchT" },
    "workerResultT":     { "type": "ProductType", "fields": ["workerStateF", "workerOutputsF"] },

    "pathA":             { "type": "StringLit", "value": "/agent/worker-a.log" },
    "pathB":             { "type": "StringLit", "value": "/agent/worker-b.log" },
    "pathC":             { "type": "StringLit", "value": "/agent/worker-c.log" },

    "wAWriteDecl":       { "type": "EffectDecl", "effectType": "writeFx", "parameters": ["pathA"] },
    "wBWriteDecl":       { "type": "EffectDecl", "effectType": "writeFx", "parameters": ["pathB"] },
    "wCWriteDecl":       { "type": "EffectDecl", "effectType": "writeFx", "parameters": ["pathC"] },

    "wASParam":          { "type": "ParameterDecl", "name": "s", "paramType": "intT" },
    "wAEParam":          { "type": "ParameterDecl", "name": "e", "paramType": "intT" },
    "wASRef":            { "type": "VarRef", "binder": "wASParam" },
    "wAERef":            { "type": "VarRef", "binder": "wAEParam" },
    "wAWriteCall":       { "type": "Application", "function": "writeFn", "arguments": ["pathA"], "effectInstances": ["wAWriteDecl"] },
    "wAAccum":           { "type": "Application", "function": "addFn", "arguments": ["wASRef", "wAERef"] },
    "wANewState":        { "type": "Application", "function": "addFn", "arguments": ["wAWriteCall", "wAAccum"] },
    "wASomeEmit":        { "type": "SumValue", "ofType": "optionIntT", "caseName": "Some", "payload": "wANewState" },
    "wAO0V":             { "type": "ProductFieldValue", "fieldName": "output_0", "value": "wASomeEmit" },
    "wAOutputBatchV":    { "type": "ProductValue", "ofType": "workerOutputBatchT", "fields": ["wAO0V"] },
    "wAStateV":          { "type": "ProductFieldValue", "fieldName": "state", "value": "wANewState" },
    "wAOutputsV":        { "type": "ProductFieldValue", "fieldName": "outputs", "value": "wAOutputBatchV" },
    "wAResultV":         { "type": "ProductValue", "ofType": "workerResultT", "fields": ["wAStateV", "wAOutputsV"] },
    "wATransition":      { "type": "Lambda", "parameters": ["wASParam", "wAEParam"], "body": "wAResultV", "effects": ["writeFx"] },

    "wBSParam":          { "type": "ParameterDecl", "name": "s", "paramType": "intT" },
    "wBEParam":          { "type": "ParameterDecl", "name": "e", "paramType": "intT" },
    "wBSRef":            { "type": "VarRef", "binder": "wBSParam" },
    "wBERef":            { "type": "VarRef", "binder": "wBEParam" },
    "wBWriteCall":       { "type": "Application", "function": "writeFn", "arguments": ["pathB"], "effectInstances": ["wBWriteDecl"] },
    "wBAccum":           { "type": "Application", "function": "addFn", "arguments": ["wBSRef", "wBERef"] },
    "wBNewState":        { "type": "Application", "function": "addFn", "arguments": ["wBWriteCall", "wBAccum"] },
    "wBSomeEmit":        { "type": "SumValue", "ofType": "optionIntT", "caseName": "Some", "payload": "wBNewState" },
    "wBO0V":             { "type": "ProductFieldValue", "fieldName": "output_0", "value": "wBSomeEmit" },
    "wBOutputBatchV":    { "type": "ProductValue", "ofType": "workerOutputBatchT", "fields": ["wBO0V"] },
    "wBStateV":          { "type": "ProductFieldValue", "fieldName": "state", "value": "wBNewState" },
    "wBOutputsV":        { "type": "ProductFieldValue", "fieldName": "outputs", "value": "wBOutputBatchV" },
    "wBResultV":         { "type": "ProductValue", "ofType": "workerResultT", "fields": ["wBStateV", "wBOutputsV"] },
    "wBTransition":      { "type": "Lambda", "parameters": ["wBSParam", "wBEParam"], "body": "wBResultV", "effects": ["writeFx"] },

    "wCSParam":          { "type": "ParameterDecl", "name": "s", "paramType": "intT" },
    "wCEParam":          { "type": "ParameterDecl", "name": "e", "paramType": "intT" },
    "wCSRef":            { "type": "VarRef", "binder": "wCSParam" },
    "wCERef":            { "type": "VarRef", "binder": "wCEParam" },
    "wCWriteCall":       { "type": "Application", "function": "writeFn", "arguments": ["pathC"], "effectInstances": ["wCWriteDecl"] },
    "wCAccum":           { "type": "Application", "function": "addFn", "arguments": ["wCSRef", "wCERef"] },
    "wCNewState":        { "type": "Application", "function": "addFn", "arguments": ["wCWriteCall", "wCAccum"] },
    "wCSomeEmit":        { "type": "SumValue", "ofType": "optionIntT", "caseName": "Some", "payload": "wCNewState" },
    "wCO0V":             { "type": "ProductFieldValue", "fieldName": "output_0", "value": "wCSomeEmit" },
    "wCOutputBatchV":    { "type": "ProductValue", "ofType": "workerOutputBatchT", "fields": ["wCO0V"] },
    "wCStateV":          { "type": "ProductFieldValue", "fieldName": "state", "value": "wCNewState" },
    "wCOutputsV":        { "type": "ProductFieldValue", "fieldName": "outputs", "value": "wCOutputBatchV" },
    "wCResultV":         { "type": "ProductValue", "ofType": "workerResultT", "fields": ["wCStateV", "wCOutputsV"] },
    "wCTransition":      { "type": "Lambda", "parameters": ["wCSParam", "wCEParam"], "body": "wCResultV", "effects": ["writeFx"] },

    "workerInitial":     { "type": "IntLit", "value": 0 },

    "supStream0Case":    { "type": "SumTypeCase", "name": "stream_0", "caseType": "intT" },
    "supStream1Case":    { "type": "SumTypeCase", "name": "stream_1", "caseType": "intT" },
    "supStream2Case":    { "type": "SumTypeCase", "name": "stream_2", "caseType": "intT" },
    "supInputEventT":    { "type": "SumType", "cases": ["supStream0Case", "supStream1Case", "supStream2Case"] },

    "supOutput0F":       { "type": "ProductTypeField", "name": "output_0", "fieldType": "optionIntT" },
    "supOutputBatchT":   { "type": "ProductType", "fields": ["supOutput0F"] },
    "supStateF":         { "type": "ProductTypeField", "name": "state", "fieldType": "intT" },
    "supOutputsF":       { "type": "ProductTypeField", "name": "outputs", "fieldType": "supOutputBatchT" },
    "supResultT":        { "type": "ProductType", "fields": ["supStateF", "supOutputsF"] },

    "supSParam":         { "type": "ParameterDecl", "name": "s", "paramType": "intT" },
    "supEParam":         { "type": "ParameterDecl", "name": "e", "paramType": "supInputEventT" },
    "supSRef":           { "type": "VarRef", "binder": "supSParam" },
    "supERef":           { "type": "VarRef", "binder": "supEParam" },

    "supVar0":           { "type": "Pattern", "kind": "variable", "patternType": "intT", "name": "v" },
    "supP0":             { "type": "Pattern", "kind": "constructor", "patternType": "supInputEventT", "caseName": "stream_0", "payloadPattern": "supVar0" },
    "supVar1":           { "type": "Pattern", "kind": "variable", "patternType": "intT", "name": "v" },
    "supP1":             { "type": "Pattern", "kind": "constructor", "patternType": "supInputEventT", "caseName": "stream_1", "payloadPattern": "supVar1" },
    "supVar2":           { "type": "Pattern", "kind": "variable", "patternType": "intT", "name": "v" },
    "supP2":             { "type": "Pattern", "kind": "constructor", "patternType": "supInputEventT", "caseName": "stream_2", "payloadPattern": "supVar2" },

    "supV0Ref":          { "type": "VarRef", "binder": "supVar0" },
    "supV1Ref":          { "type": "VarRef", "binder": "supVar1" },
    "supV2Ref":          { "type": "VarRef", "binder": "supVar2" },
    "supNew0":           { "type": "Application", "function": "addFn", "arguments": ["supSRef", "supV0Ref"] },
    "supNew1":           { "type": "Application", "function": "addFn", "arguments": ["supSRef", "supV1Ref"] },
    "supNew2":           { "type": "Application", "function": "addFn", "arguments": ["supSRef", "supV2Ref"] },
    "supCase0":          { "type": "MatchCase", "pattern": "supP0", "body": "supNew0" },
    "supCase1":          { "type": "MatchCase", "pattern": "supP1", "body": "supNew1" },
    "supCase2":          { "type": "MatchCase", "pattern": "supP2", "body": "supNew2" },
    "supNewState":       { "type": "Match", "scrutinee": "supERef", "cases": ["supCase0", "supCase1", "supCase2"] },

    "supSomeEmit":       { "type": "SumValue", "ofType": "optionIntT", "caseName": "Some", "payload": "supNewState" },
    "supO0V":            { "type": "ProductFieldValue", "fieldName": "output_0", "value": "supSomeEmit" },
    "supOutputBatchV":   { "type": "ProductValue", "ofType": "supOutputBatchT", "fields": ["supO0V"] },
    "supStateV":         { "type": "ProductFieldValue", "fieldName": "state", "value": "supNewState" },
    "supOutputsV":       { "type": "ProductFieldValue", "fieldName": "outputs", "value": "supOutputBatchV" },
    "supResultV":        { "type": "ProductValue", "ofType": "supResultT", "fields": ["supStateV", "supOutputsV"] },
    "supTransition":     { "type": "Lambda", "parameters": ["supSParam", "supEParam"], "body": "supResultV" },
    "supInitial":        { "type": "IntLit", "value": 0 },

    "extInputA":         { "type": "EventStream", "eventType": "intT", "streamKind": "external" },
    "extInputB":         { "type": "EventStream", "eventType": "intT", "streamKind": "external" },
    "extInputC":         { "type": "EventStream", "eventType": "intT", "streamKind": "external" },
    "chanA":             { "type": "EventStream", "eventType": "intT", "streamKind": "internal" },
    "chanB":             { "type": "EventStream", "eventType": "intT", "streamKind": "internal" },
    "chanC":             { "type": "EventStream", "eventType": "intT", "streamKind": "internal" },
    "extOutput":         { "type": "EventStream", "eventType": "intT", "streamKind": "output" },
    "receiveFx":         { "type": "EffectCategory", "categoryName": "StateMachine.Receive" },
    "sendFx":            { "type": "EffectCategory", "categoryName": "StateMachine.Send" },

    "workerA": {
      "type": "StateMachine",
      "transitionFn": "wATransition",
      "initialState": "workerInitial",
      "inputStreams": ["extInputA"],
      "outputStreams": ["chanA"],
      "effects": ["receiveFx", "sendFx", "writeFx"]
    },
    "workerB": {
      "type": "StateMachine",
      "transitionFn": "wBTransition",
      "initialState": "workerInitial",
      "inputStreams": ["extInputB"],
      "outputStreams": ["chanB"],
      "effects": ["receiveFx", "sendFx", "writeFx"]
    },
    "workerC": {
      "type": "StateMachine",
      "transitionFn": "wCTransition",
      "initialState": "workerInitial",
      "inputStreams": ["extInputC"],
      "outputStreams": ["chanC"],
      "effects": ["receiveFx", "sendFx", "writeFx"]
    },
    "supervisor": {
      "type": "StateMachine",
      "transitionFn": "supTransition",
      "initialState": "supInitial",
      "inputStreams": ["chanA", "chanB", "chanC"],
      "outputStreams": ["extOutput"],
      "effects": ["receiveFx", "sendFx"]
    },

    "letC":      { "type": "Let", "name": "_workerC", "value": "workerC", "body": "supervisor" },
    "letB":      { "type": "Let", "name": "_workerB", "value": "workerB", "body": "letC" },
    "rootLet":   { "type": "Let", "name": "_workerA", "value": "workerA", "body": "letB" }
  }
}
