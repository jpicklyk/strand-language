{
  "version": 1,
  "root": "main",
  "nodes": {
    "intT":         { "type": "PrimitiveType", "kind": "Int" },
    "strT":         { "type": "PrimitiveType", "kind": "String" },

    "tagField":     { "type": "ProductTypeField", "name": "tag", "fieldType": "strT" },
    "childHeadSelf":{ "type": "RecursiveSelf", "depth": 1 },
    "childHeadF":   { "type": "ProductTypeField", "name": "head", "fieldType": "childHeadSelf" },
    "childTailSelf":{ "type": "RecursiveSelf", "depth": 0 },
    "childTailF":   { "type": "ProductTypeField", "name": "tail", "fieldType": "childTailSelf" },
    "childConsProd":{ "type": "ProductType", "fields": ["childHeadF", "childTailF"] },
    "childConsCase":{ "type": "SumTypeCase", "name": "Cons", "caseType": "childConsProd" },
    "childNilCase": { "type": "SumTypeCase", "name": "Nil", "caseType": null },
    "childListBody":{ "type": "SumType", "cases": ["childConsCase", "childNilCase"] },
    "childListT":   { "type": "RecursiveType", "body": "childListBody" },
    "childrenField":{ "type": "ProductTypeField", "name": "children", "fieldType": "childListT" },
    "elementProd":  { "type": "ProductType", "fields": ["tagField", "childrenField"] },

    "textCase":     { "type": "SumTypeCase", "name": "Text", "caseType": "strT" },
    "elemCase":     { "type": "SumTypeCase", "name": "Element", "caseType": "elementProd" },
    "elBody":       { "type": "SumType", "cases": ["textCase", "elemCase"] },
    "elT":          { "type": "RecursiveType", "body": "elBody" },

    "projTop":      { "type": "RecursiveProjection", "recursiveType": "elT",
                      "path": [ { "step": "Unfold" } ] },
    "projElem":     { "type": "RecursiveProjection", "recursiveType": "elT",
                      "path": [ { "step": "Case", "caseName": "Element" } ] },
    "projChildren": { "type": "RecursiveProjection", "recursiveType": "elT",
                      "path": [ { "step": "Case", "caseName": "Element" },
                                { "step": "Field", "fieldName": "children" },
                                { "step": "Unfold" } ] },
    "projChildCons":{ "type": "RecursiveProjection", "recursiveType": "elT",
                      "path": [ { "step": "Case", "caseName": "Element" },
                                { "step": "Field", "fieldName": "children" },
                                { "step": "Unfold" },
                                { "step": "Case", "caseName": "Cons" } ] },

    "aStr":         { "type": "StringLit", "value": "a" },
    "bStr":         { "type": "StringLit", "value": "b" },
    "divStr":       { "type": "StringLit", "value": "div" },
    "spanStr":      { "type": "StringLit", "value": "span" },
    "textA":        { "type": "SumValue", "ofType": "projTop", "caseName": "Text", "payload": "aStr" },
    "textB":        { "type": "SumValue", "ofType": "projTop", "caseName": "Text", "payload": "bStr" },

    "childNil":     { "type": "SumValue", "ofType": "projChildren", "caseName": "Nil", "payload": null },

    "spanKidHeadFv":{ "type": "ProductFieldValue", "fieldName": "head", "value": "textB" },
    "spanKidTailFv":{ "type": "ProductFieldValue", "fieldName": "tail", "value": "childNil" },
    "spanKidConsProd":{ "type": "ProductValue", "ofType": "projChildCons", "fields": ["spanKidHeadFv", "spanKidTailFv"] },
    "spanChildren": { "type": "SumValue", "ofType": "projChildren", "caseName": "Cons", "payload": "spanKidConsProd" },
    "spanTagFv":    { "type": "ProductFieldValue", "fieldName": "tag", "value": "spanStr" },
    "spanChildrenFv":{ "type": "ProductFieldValue", "fieldName": "children", "value": "spanChildren" },
    "spanProd":     { "type": "ProductValue", "ofType": "projElem", "fields": ["spanTagFv", "spanChildrenFv"] },
    "spanEl":       { "type": "SumValue", "ofType": "projTop", "caseName": "Element", "payload": "spanProd" },

    "divKid1HeadFv":{ "type": "ProductFieldValue", "fieldName": "head", "value": "spanEl" },
    "divKid1TailFv":{ "type": "ProductFieldValue", "fieldName": "tail", "value": "childNil" },
    "divKid1ConsProd":{ "type": "ProductValue", "ofType": "projChildCons", "fields": ["divKid1HeadFv", "divKid1TailFv"] },
    "divKidsTail":  { "type": "SumValue", "ofType": "projChildren", "caseName": "Cons", "payload": "divKid1ConsProd" },
    "divKid0HeadFv":{ "type": "ProductFieldValue", "fieldName": "head", "value": "textA" },
    "divKid0TailFv":{ "type": "ProductFieldValue", "fieldName": "tail", "value": "divKidsTail" },
    "divKid0ConsProd":{ "type": "ProductValue", "ofType": "projChildCons", "fields": ["divKid0HeadFv", "divKid0TailFv"] },
    "divChildren":  { "type": "SumValue", "ofType": "projChildren", "caseName": "Cons", "payload": "divKid0ConsProd" },
    "divTagFv":     { "type": "ProductFieldValue", "fieldName": "tag", "value": "divStr" },
    "divChildrenFv":{ "type": "ProductFieldValue", "fieldName": "children", "value": "divChildren" },
    "divProd":      { "type": "ProductValue", "ofType": "projElem", "fields": ["divTagFv", "divChildrenFv"] },
    "divEl":        { "type": "SumValue", "ofType": "projTop", "caseName": "Element", "payload": "divProd" },

    "countListFnT": { "type": "FunctionType", "parameters": ["projChildren"], "result": "intT" },

    "listSelfParam":{ "type": "ParameterDecl", "name": "listSelf", "paramType": "countListFnT" },
    "lstParam":     { "type": "ParameterDecl", "name": "lst", "paramType": "projChildren" },
    "consPatVar":   { "type": "Pattern", "kind": "variable", "patternType": "projChildCons", "name": "c" },
    "consPat":      { "type": "Pattern", "kind": "constructor", "patternType": "projChildren", "caseName": "Cons", "payloadPattern": "consPatVar" },
    "cRef":         { "type": "VarRef", "binder": "consPatVar" },
    "headEl":       { "type": "ProductFieldGet", "target": "cRef", "fieldName": "head" },
    "tailLst":      { "type": "ProductFieldGet", "target": "cRef", "fieldName": "tail" },

    "addFnT":       { "type": "FunctionType", "parameters": ["intT", "intT"], "result": "intT" },
    "addFn":        { "type": "ForeignNode", "target": "strand-builtin:Int.Add", "foreignType": "addFnT" },

    "listSelfRef":  { "type": "VarRef", "binder": "listSelfParam" },
    "countTail":    { "type": "Application", "function": "listSelfRef", "arguments": ["tailLst"] },

    "textWildPat":  { "type": "Pattern", "kind": "wildcard", "patternType": "strT" },
    "textPat":      { "type": "Pattern", "kind": "constructor", "patternType": "elT", "caseName": "Text", "payloadPattern": "textWildPat" },
    "oneLit":       { "type": "IntLit", "value": 1 },
    "textMc":       { "type": "MatchCase", "pattern": "textPat", "body": "oneLit" },

    "elemPatVar":   { "type": "Pattern", "kind": "variable", "patternType": "projElem", "name": "e" },
    "elemPat":      { "type": "Pattern", "kind": "constructor", "patternType": "elT", "caseName": "Element", "payloadPattern": "elemPatVar" },
    "eRef":         { "type": "VarRef", "binder": "elemPatVar" },
    "eKids":        { "type": "ProductFieldGet", "target": "eRef", "fieldName": "children" },
    "countKids":    { "type": "Application", "function": "listSelfRef", "arguments": ["eKids"] },
    "elemMc":       { "type": "MatchCase", "pattern": "elemPat", "body": "countKids" },

    "headCount":    { "type": "Match", "scrutinee": "headEl", "cases": ["textMc", "elemMc"] },
    "addCall":      { "type": "Application", "function": "addFn", "arguments": ["headCount", "countTail"] },
    "consMc":       { "type": "MatchCase", "pattern": "consPat", "body": "addCall" },

    "nilPat":       { "type": "Pattern", "kind": "constructor", "patternType": "projChildren", "caseName": "Nil" },
    "zeroL":        { "type": "IntLit", "value": 0 },
    "nilMc":        { "type": "MatchCase", "pattern": "nilPat", "body": "zeroL" },
    "lstRefBody":   { "type": "VarRef", "binder": "lstParam" },
    "listMatch":    { "type": "Match", "scrutinee": "lstRefBody", "cases": ["consMc", "nilMc"] },
    "listLambda":   { "type": "Lambda", "parameters": ["listSelfParam", "lstParam"], "body": "listMatch" },
    "listFix":      { "type": "Fixpoint", "recursionType": "countListFnT", "body": "listLambda" },

    "topElemPatVar":{ "type": "Pattern", "kind": "variable", "patternType": "projElem", "name": "te" },
    "topElemPat":   { "type": "Pattern", "kind": "constructor", "patternType": "elT", "caseName": "Element", "payloadPattern": "topElemPatVar" },
    "teRef":        { "type": "VarRef", "binder": "topElemPatVar" },
    "teKids":       { "type": "ProductFieldGet", "target": "teRef", "fieldName": "children" },
    "topCountKids": { "type": "Application", "function": "listFix", "arguments": ["teKids"] },
    "topElemMc":    { "type": "MatchCase", "pattern": "topElemPat", "body": "topCountKids" },
    "topTextWild":  { "type": "Pattern", "kind": "wildcard", "patternType": "strT" },
    "topTextPat":   { "type": "Pattern", "kind": "constructor", "patternType": "elT", "caseName": "Text", "payloadPattern": "topTextWild" },
    "topOne":       { "type": "IntLit", "value": 1 },
    "topTextMc":    { "type": "MatchCase", "pattern": "topTextPat", "body": "topOne" },

    "main":         { "type": "Match", "scrutinee": "divEl", "cases": ["topTextMc", "topElemMc"] }
  }
}
