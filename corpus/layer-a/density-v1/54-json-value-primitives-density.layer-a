# Slice 1+2+3 (Layer A density v1) fixture for 54-json-value-primitives.
# Demonstrates implicit prelude (no intT/boolT/stringT decl), inline
# literal (42 in SV.payload), and auto-VarRef (jvParam in LAM.body).
@v=1 root=schemaClaim
jsonNullCase SCS "JsonNull" _
jsonBoolCase SCS "JsonBool" boolT
jsonNumberCase SCS "JsonNumber" intT
jsonStringCase SCS "JsonString" stringT
jsonValueT SUM [jsonNullCase jsonBoolCase jsonNumberCase jsonStringCase]
jsonValueSchema SCH "JsonValue" jsonValueT []
numberValue SV jsonValueT "JsonNumber" 42
jvParam PRC "jv" jsonValueSchema
identityOfJsonValue LAM [jvParam] jvParam
schemaClaim APP identityOfJsonValue [numberValue]
