# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment overrides
local.properties
.env
.env.local

# Worktree scratch space (parallel agent isolation creates these)
.worktrees/
.claude/worktrees/

# Planning scratch — local-only thinking-through-implementation docs,
# not part of the design corpus or proposals/ directory. Anything that
# matures here gets promoted to proposals/ or design/ on its way to
# implementation.
plan/

# User-specific Claude Code settings (per-machine permission grants etc.).
# The shared .claude/skills/ tree IS committed; only the local-overrides
# file is excluded.
.claude/settings.local.json

# Dynamic-evaluation run scratch. Each `strand-eval step` invocation
# writes a timestamped or named directory here; by default these are
# local-only experiment outputs. Runs that back numbers published in
# evaluation/dynamic-results.md are tracked explicitly via the negation
# patterns below — add a new negation line when a run becomes a
# published artifact.
evaluation/dynamic/runs/*/
!evaluation/dynamic/runs/2026-05-26-run5/
!evaluation/dynamic/runs/2026-05-26-run5-biased-orchestrator/
!evaluation/dynamic/runs/2026-05-25-run3-postfix/
!evaluation/dynamic/runs/2026-05-25-subagent-sweep/
!evaluation/dynamic/runs/2026-05-28-run6/
!evaluation/dynamic/runs/2026-05-28-run6-validate/
!evaluation/dynamic/runs/2026-05-28-skill-eval/
!evaluation/dynamic/runs/2026-05-28-skill-eval-iter2/
!evaluation/dynamic/runs/strand-*/
!evaluation/dynamic/runs/python-*/
