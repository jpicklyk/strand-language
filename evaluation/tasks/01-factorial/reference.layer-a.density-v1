@v=1 root=app
factT FNT [intT] intT
recurse PRC "recurse" factT
n PRC "n" intT
nIsZero APP eqInt [n 0]
litTrue BLT true
patTrue PLT boolT litTrue
caseTrue MC patTrue 1
litFalse BLT false
patFalse PLT boolT litFalse
nMinus1 APP sub [n 1]
recCall APP recurse [nMinus1]
mulBody APP mul [n recCall]
caseFalse MC patFalse mulBody
matchBody MAT nIsZero [caseTrue caseFalse]
bodyLam LAM [recurse n] matchBody
fact FIX factT bodyLam
app APP fact [5]
