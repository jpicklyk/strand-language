# Layer A form of corpus/21-fixpoint-factorial.json — the first
# recursive Strand program: factorial via FIX + MAT + foreign builtins.
# fact(5) → 120.
@v=1 root=app
intT PRM Int
boolT PRM Bool
factT FNT [intT] intT
subT FNT [intT intT] intT
sub FN "strand-builtin:Int.Sub" subT
mulT FNT [intT intT] intT
mul FN "strand-builtin:Int.Mul" mulT
eqT FNT [intT intT] boolT
eq FN "strand-builtin:Int.Eq" eqT
recurse PRC "recurse" factT
n PRC "n" intT
zero ILT 0
one ILT 1
nRef VAR n
nIsZero APP eq [nRef zero]
litTrue BLT true
patTrue PLT boolT litTrue
caseTrue MC patTrue one
litFalse BLT false
patFalse PLT boolT litFalse
recRef VAR recurse
nMinus1 APP sub [nRef one]
recCall APP recRef [nMinus1]
mulBody APP mul [nRef recCall]
caseFalse MC patFalse mulBody
matchBody MAT nIsZero [caseTrue caseFalse]
bodyLam LAM [recurse n] matchBody
fact FIX factT bodyLam
five ILT 5
app APP fact [five]
