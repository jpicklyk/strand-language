# Layer A form of corpus/32-recursive-list-sum.json — recursive list
# (μ. Cons{head: Int, tail: <self>} | Nil) with a recursive sum
# function. Computes sum([1, 2, 3]) = 6.
@v=1 root=main
intT PRM Int

# Recursive type: μ. Cons({head: Int, tail: <self>}) | Nil.
# The "inner" product uses RecursiveSelf for tail; the "outer" product
# (used at value-construction sites) uses the recursive type itself.
headFieldInner PRF "head" intT
tailFieldInner PRF "tail" recSelf
consProductInner PRD [headFieldInner tailFieldInner]

consCase SCS "Cons" consProductInner
nilCase SCS "Nil" _
listBody SUM [consCase nilCase]
recSelf RS
listT RT listBody

headFieldOuter PRF "head" intT
tailFieldOuter PRF "tail" listT
consProductOuter PRD [headFieldOuter tailFieldOuter]

# add: Int -> Int -> Int
addT FNT [intT intT] intT
add FN "strand-builtin:Int.Add" addT

# sum: List -> Int via Fixpoint.
sumType FNT [listT] intT
recurse PRC "recurse" sumType
xs PRC "xs" listT
xsRef VAR xs

# Cons arm: bind the product payload as `p`, extract head/tail, recurse.
varP PVR consProductOuter "p"
patCons PCN listT "Cons" varP
pRef VAR varP
hExtract PFG pRef "head"
tExtract PFG pRef "tail"
recRef VAR recurse
sumOfTail APP recRef [tExtract]
sumBody APP add [hExtract sumOfTail]
caseCons MC patCons sumBody

# Nil arm: return 0.
zero ILT 0
patNil PCN listT "Nil" _
caseNil MC patNil zero

matchBody MAT xsRef [caseCons caseNil]
bodyLam LAM [recurse xs] matchBody
sumFn FIX sumType bodyLam

# Construct Cons(1, Cons(2, Cons(3, Nil))).
nilVal SV listT "Nil" _
three ILT 3
h3 PFV "head" three
t3 PFV "tail" nilVal
p3 PV consProductOuter [h3 t3]
node3 SV listT "Cons" p3
two ILT 2
h2 PFV "head" two
t2 PFV "tail" node3
p2 PV consProductOuter [h2 t2]
node2 SV listT "Cons" p2
one ILT 1
h1 PFV "head" one
t1 PFV "tail" node2
p1 PV consProductOuter [h1 t1]
list123 SV listT "Cons" p1

main APP sumFn [list123]
