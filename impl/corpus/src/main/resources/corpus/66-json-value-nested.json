{
  "version": 1,
  "root": "schemaClaim",
  "nodes": {
    "intT":              { "type": "PrimitiveType", "kind": "Int" },
    "boolT":             { "type": "PrimitiveType", "kind": "Bool" },
    "stringT":           { "type": "PrimitiveType", "kind": "String" },

    "recSelf":           { "type": "RecursiveSelf" },

    "arrConsHead":       { "type": "ProductTypeField", "name": "head", "fieldType": "recSelf" },
    "arrConsTail":       { "type": "ProductTypeField", "name": "tail", "fieldType": "recSelf" },
    "arrConsProd":       { "type": "ProductType", "fields": ["arrConsHead", "arrConsTail"] },

    "objConsKey":        { "type": "ProductTypeField", "name": "key",   "fieldType": "stringT" },
    "objConsValue":      { "type": "ProductTypeField", "name": "value", "fieldType": "recSelf" },
    "objConsTail":       { "type": "ProductTypeField", "name": "tail",  "fieldType": "recSelf" },
    "objConsProd":       { "type": "ProductType", "fields": ["objConsKey", "objConsValue", "objConsTail"] },

    "jsonNullCase":      { "type": "SumTypeCase", "name": "JsonNull",        "caseType": null },
    "jsonBoolCase":      { "type": "SumTypeCase", "name": "JsonBool",        "caseType": "boolT" },
    "jsonNumberCase":    { "type": "SumTypeCase", "name": "JsonNumber",      "caseType": "intT" },
    "jsonStringCase":    { "type": "SumTypeCase", "name": "JsonString",      "caseType": "stringT" },
    "jsonArrConsCase":   { "type": "SumTypeCase", "name": "JsonArrayCons",   "caseType": "arrConsProd" },
    "jsonArrNilCase":    { "type": "SumTypeCase", "name": "JsonArrayNil",    "caseType": null },
    "jsonObjConsCase":   { "type": "SumTypeCase", "name": "JsonObjectCons",  "caseType": "objConsProd" },
    "jsonObjNilCase":    { "type": "SumTypeCase", "name": "JsonObjectNil",   "caseType": null },
    "jsonValueBody":     { "type": "SumType", "cases": [
      "jsonNullCase", "jsonBoolCase", "jsonNumberCase", "jsonStringCase",
      "jsonArrConsCase", "jsonArrNilCase",
      "jsonObjConsCase", "jsonObjNilCase"
    ] },
    "jsonValueT":        { "type": "RecursiveType", "body": "jsonValueBody" },

    "jsonValueSchema": {
      "type": "Schema",
      "schemaName": "JsonValueFull",
      "valueType": "jsonValueT",
      "invariants": []
    },

    "arrHeadOuter":      { "type": "ProductTypeField", "name": "head", "fieldType": "jsonValueT" },
    "arrTailOuter":      { "type": "ProductTypeField", "name": "tail", "fieldType": "jsonValueT" },
    "arrConsProdOuter":  { "type": "ProductType", "fields": ["arrHeadOuter", "arrTailOuter"] },

    "litOne":            { "type": "IntLit", "value": 1 },
    "litTwo":            { "type": "IntLit", "value": 2 },

    "numOne":            { "type": "SumValue", "ofType": "jsonValueT", "caseName": "JsonNumber", "payload": "litOne" },
    "numTwo":            { "type": "SumValue", "ofType": "jsonValueT", "caseName": "JsonNumber", "payload": "litTwo" },

    "arrNilVal":         { "type": "SumValue", "ofType": "jsonValueT", "caseName": "JsonArrayNil", "payload": null },

    "consTwoHead":       { "type": "ProductFieldValue", "fieldName": "head", "value": "numTwo" },
    "consTwoTail":       { "type": "ProductFieldValue", "fieldName": "tail", "value": "arrNilVal" },
    "consTwoProd":       { "type": "ProductValue", "ofType": "arrConsProdOuter", "fields": ["consTwoHead", "consTwoTail"] },
    "arrCellTwo":        { "type": "SumValue", "ofType": "jsonValueT", "caseName": "JsonArrayCons", "payload": "consTwoProd" },

    "consOneHead":       { "type": "ProductFieldValue", "fieldName": "head", "value": "numOne" },
    "consOneTail":       { "type": "ProductFieldValue", "fieldName": "tail", "value": "arrCellTwo" },
    "consOneProd":       { "type": "ProductValue", "ofType": "arrConsProdOuter", "fields": ["consOneHead", "consOneTail"] },
    "arrayValue":        { "type": "SumValue", "ofType": "jsonValueT", "caseName": "JsonArrayCons", "payload": "consOneProd" },

    "jvParam":           { "type": "ParameterDecl", "name": "jv", "paramType": "jsonValueSchema" },
    "jvRef":             { "type": "VarRef", "binder": "jvParam" },
    "identityOfJsonValue": { "type": "Lambda", "parameters": ["jvParam"], "body": "jvRef" },

    "schemaClaim": {
      "type": "Application",
      "function": "identityOfJsonValue",
      "arguments": ["arrayValue"]
    }
  }
}
