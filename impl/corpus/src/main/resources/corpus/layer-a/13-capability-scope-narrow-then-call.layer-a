# Layer A form of corpus/13-capability-scope-narrow-then-call.json — a
# CapabilityScope narrows the surrounding context to {Time.Now} and
# then calls a Lambda that declares Time.Now. Demonstrates CAP code.
@v=1 root=scope
intT PRM Int
timeFx EFC "Time.Now"
netFx EFC "Network.Connect"
gX PRC "x" intT
gBody VAR gX
g LAM [gX] gBody [timeFx]
seven ILT 7
callG APP g [seven]
scope CAP [timeFx] callG
