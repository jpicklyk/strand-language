# Layer A form of corpus/35-refined-logger-authorized-path.json — Q-031
# step 3 positive confused-deputy demo. Logger Lambda writes to caller-
# supplied path; with an EffectDecl referencing the parameter, the
# refinement check matches the granted capability's authorized path.
# Demonstrates EFD (EffectDecl) and Application's optional
# effectInstances slot.
@v=1 root=outerApp
intT PRM Int
strT PRM String
fsWriteFx EFC "Filesystem.Write" [strT]
writeT FNT [strT] intT [fsWriteFx]
write FN "strand-builtin:Filesystem.Write" writeT [fsWriteFx]
loggerP PRC "callerPath" strT
loggerPRef VAR loggerP
loggerDecl EFD fsWriteFx [loggerPRef]
loggerCall APP write [loggerPRef] [] [loggerDecl]
logger LAM [loggerP] loggerCall [fsWriteFx]
authPath STR "/var/log/app.log"
outerApp APP logger [authPath]
