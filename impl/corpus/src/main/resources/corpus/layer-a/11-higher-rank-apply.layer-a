# Layer A form of corpus/11-higher-rank-apply.json — minimal explicit
# higher-rank example: apply : (forall a. a -> a) -> Int -> Int applied
# to a polymorphic identity and 7. Evaluates to 7.
@v=1 root=topApp
T_a TPM "a"
intT PRM Int
idFunType FNT [T_a] T_a
idForallType FAL [T_a] idFunType
f PRC "f" idForallType
n PRC "n" intT
fRef VAR f
nRef VAR n
callFN APP fRef [nRef] [intT]
innerN LAM [n] callFN
applyLambda LAM [f] innerN
idX PRC "x" T_a
idXRef VAR idX
idInner LAM [idX] idXRef
idLambda TAB [T_a] idInner
argN ILT 7
partialApply APP applyLambda [idLambda] []
topApp APP partialApply [argN] []
