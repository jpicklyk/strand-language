# Layer A form of corpus/25-option-some-unwrap.json — Option-like sum
# constructed as Some(42), Matched with constructor patterns (PCN +
# nested PVR for the payload binder). Returns 42.
@v=1 root=result
intT PRM Int
someCase SCS "Some" intT
noneCase SCS "None" _
optionT SUM [someCase noneCase]
lit42 ILT 42
someValue SV optionT "Some" lit42
varN PVR intT "n"
patSome PCN optionT "Some" varN
nRef VAR varN
caseSome MC patSome nRef
patNone PCN optionT "None"
zero ILT 0
caseNone MC patNone zero
result MAT someValue [caseSome caseNone]
