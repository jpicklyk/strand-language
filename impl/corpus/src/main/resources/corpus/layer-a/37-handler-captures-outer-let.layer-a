# Layer A form of corpus/37-handler-captures-outer-let.json — Handler
# whose `handle` Lambda reads a value bound by an outer Let. Confirms
# the handler's lexical environment is captured at Handler-entry.
@v=1 root=letT
intT PRM Int
timeFx EFC "Time.Now"
nowT FNT [] intT [timeFx]
now FN "strand-builtin:Time.Now" nowT [timeFx]
callNow APP now []
fakeT FNT [] intT
tRef VAR letT
fakeLam LAM [] tRef
handler H timeFx fakeLam callNow
tLit ILT 1700000000
letT LET "t" tLit handler
