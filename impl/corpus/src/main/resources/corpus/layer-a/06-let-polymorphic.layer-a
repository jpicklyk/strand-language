# Layer A form of corpus/06-let-polymorphic.json — let-bound polymorphic
# identity instantiated at two different types via the same let-binder
# `id`. Demonstrates that a polymorphic Let value can be instantiated
# multiple ways at different use sites.
@v=1 root=letId
T_a TPM "a"
intT PRM Int
boolT PRM Bool
x PRC "x" T_a
x_use VAR x
idInner LAM [x] x_use
idLambda TAB [T_a] idInner
idRef1 VAR letId
argInt ILT 42
callInt APP idRef1 [argInt] [intT]
idRef2 VAR letId
argBool BLT true
callBool APP idRef2 [argBool] [boolT]
innerLet LET "_unused" callInt callBool
letId LET "id" idLambda innerLet
