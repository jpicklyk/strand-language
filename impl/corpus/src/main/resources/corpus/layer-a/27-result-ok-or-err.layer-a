# Layer A form of corpus/27-result-ok-or-err.json — Result-like sum
# (Ok(Int) | Err(String)). Construct Ok(7), Match with two constructor
# patterns of different payload types. Result: 107.
@v=1 root=result
intT PRM Int
strT PRM String
okCase SCS "Ok" intT
errCase SCS "Err" strT
resultT SUM [okCase errCase]
okPayload ILT 7
okValue SV resultT "Ok" okPayload
varN PVR intT "n"
patOk PCN resultT "Ok" varN
addT FNT [intT intT] intT
add FN "strand-builtin:Int.Add" addT
lit100 ILT 100
nRef VAR varN
okBody APP add [nRef lit100]
caseOk MC patOk okBody
wildErr PWC strT
patErr PCN resultT "Err" wildErr
negOne ILT -1
caseErr MC patErr negOne
result MAT okValue [caseOk caseErr]
