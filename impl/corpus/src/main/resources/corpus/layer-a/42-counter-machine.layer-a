# Layer A form of corpus/42-counter-machine.json — state machine with
# Sum-typed events (Increment | Decrement | Reset). Transition Matches
# on the event sum.
@v=1 root=counterMachine
intT PRM Int
unitT PRM Unit
incCase SCS "Increment" _
decCase SCS "Decrement" _
resetCase SCS "Reset" _
eventT SUM [incCase decCase resetCase]
emptyOutputsT PRD []
stateFieldT PRF "state" intT
outputsFieldT PRF "outputs" emptyOutputsT
resultT PRD [stateFieldT outputsFieldT]
addFnT FNT [intT intT] intT
subFnT FNT [intT intT] intT
addFn FN "strand-builtin:Int.Add" addFnT
subFn FN "strand-builtin:Int.Sub" subFnT
stateParam PRC "s" intT
eventParam PRC "e" eventT
stateParamRef VAR stateParam
eventParamRef VAR eventParam
litOne ILT 1
litZero ILT 0
addOne APP addFn [stateParamRef litOne]
subOne APP subFn [stateParamRef litOne]
patInc PCN eventT "Increment"
patDec PCN eventT "Decrement"
patReset PCN eventT "Reset"
caseInc MC patInc addOne
caseDec MC patDec subOne
caseReset MC patReset litZero
newState MAT eventParamRef [caseInc caseDec caseReset]
stateFieldV PFV "state" newState
emptyOutputsV PV emptyOutputsT []
outputsFieldV PFV "outputs" emptyOutputsV
transitionResult PV resultT [stateFieldV outputsFieldV]
transitionLambda LAM [stateParam eventParam] transitionResult
initialState ILT 0
inputStream ESE eventT
receiveFx EFC "StateMachine.Receive"
counterMachine SM transitionLambda initialState [inputStream] [] [receiveFx]
