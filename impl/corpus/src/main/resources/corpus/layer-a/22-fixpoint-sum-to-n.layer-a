# Layer A form of corpus/22-fixpoint-sum-to-n.json — sum 1..N via FIX
# + MAT. sum(10) → 55.
@v=1 root=app
intT PRM Int
boolT PRM Bool
sumT FNT [intT] intT
addT FNT [intT intT] intT
add FN "strand-builtin:Int.Add" addT
subT FNT [intT intT] intT
sub FN "strand-builtin:Int.Sub" subT
leT FNT [intT intT] boolT
le FN "strand-builtin:Int.Le" leT
recurse PRC "recurse" sumT
n PRC "n" intT
zero ILT 0
one ILT 1
nRef VAR n
nLeZero APP le [nRef zero]
litTrue BLT true
patTrue PLT boolT litTrue
caseTrue MC patTrue zero
litFalse BLT false
patFalse PLT boolT litFalse
recRef VAR recurse
nMinus1 APP sub [nRef one]
recCall APP recRef [nMinus1]
addBody APP add [nRef recCall]
caseFalse MC patFalse addBody
matchBody MAT nLeZero [caseTrue caseFalse]
bodyLam LAM [recurse n] matchBody
sum FIX sumT bodyLam
ten ILT 10
app APP sum [ten]
