# Layer A form of corpus/12-effect-declared-and-granted.json — a Lambda
# that declares Time.Now applied to 7. Demonstrates EFC (EffectCategory)
# and Lambda's optional `effects` list slot.
@v=1 root=callG
intT PRM Int
timeFx EFC "Time.Now"
gX PRC "x" intT
gBody VAR gX
g LAM [gX] gBody [timeFx]
seven ILT 7
callG APP g [seven]
