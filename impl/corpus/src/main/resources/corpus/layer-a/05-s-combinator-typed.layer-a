# Layer A form of corpus/05-s-combinator-typed.json — the S combinator
# wrapped as Λa,b,c. \f g x. (f x)(g x). Inner Applications are
# monomorphic (their function types contain free TypeParameters bound by
# the enclosing TypeAbstraction). Verify-only program.
@v=1 root=sLambda
T_a TPM "a"
T_b TPM "b"
T_c TPM "c"
fType_inner FNT [T_b] T_c
fType FNT [T_a] fType_inner
gType FNT [T_a] T_b
f PRC "f" fType
g PRC "g" gType
x PRC "x" T_a
x_useFx VAR x
f_use VAR f
fx APP f_use [x_useFx] []
x_useGx VAR x
g_use VAR g
gx APP g_use [x_useGx] []
fxgx APP fx [gx] []
innerX LAM [x] fxgx
innerG LAM [g] innerX
sInner LAM [f] innerG
sLambda TAB [T_a T_b T_c] sInner
